{
  "installCommand": "npm install --include=dev",
  "buildCommand": "npm run build:prod",
  "outputDirectory": "dist/client",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/client/index.html"
    }
  ]
}
